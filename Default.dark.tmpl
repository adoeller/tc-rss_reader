<html>
<head>
<meta charset="utf-8">
<title><%title%></title>
<style>
body { background:#1e1e1e; color:#e0e0e0; font-family:Segoe UI,Arial,sans-serif; margin:10px; }
a { color:#5fb4ff; }
a:visited { color:#b07fff; }
hr { border:0; border-top:1px solid #444; }
h2 { color:#fff; margin:0 0 8px 0; }
.meta { color:#999; font-size:0.9em; }
table { border-collapse:collapse; }
td { padding:4px 8px; vertical-align:top; }
.label { color:#999; text-align:right; white-space:nowrap; }
</style>
</head>
<body topmargin="5" leftmargin="5" marginheight="5" marginwidth="5">

<h2><%title%></h2>
<p class="meta"><%pubDate%></p>

<p><%description%></p>

<p><a href="<%link%>"><%link%></a></p>

<hr>
<table>
<tr><td class="label">Author:</td><td><%author%></td></tr>
<tr><td class="label">Category:</td><td><%category%></td></tr>
</table>

</body>
</html>
